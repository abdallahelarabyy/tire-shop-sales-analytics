table 'Product Sales'
	lineageTag: 1223d8e5-6cc3-5808-9615-e696d052c435

	measure Revenue = SUM ( 'Product Sales'[Sales Amount] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: c9817849-8653-5553-a68b-ac435c9c0651

	measure Cost = SUM ( 'Product Sales'[Cost Amount] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 71a9090c-1f93-53e5-b2f0-f417d05a836f

	measure Profit = SUM ( 'Product Sales'[Profit Amount] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 3b468f56-fe59-5321-ae3f-fa263794794c

	measure 'Margin %' = DIVIDE ( [Profit], [Revenue] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: d447fcb1-e445-5ac3-b909-cf1fa627602f

	measure 'Units Sold' = SUM ( 'Product Sales'[Units] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: c81a54c0-3e7e-519e-a423-f95f396ff478

	measure 'Products Sold' = COUNTROWS ( 'Product Sales' )
		formatString: #,0
		displayFolder: Sales
		lineageTag: b0a60bed-28cc-578d-88cd-8d95011b8326

	measure 'Avg Selling Price' = DIVIDE ( [Revenue], [Units Sold] )
		formatString: #,0
		displayFolder: Per unit
		lineageTag: 29ee6dd7-8eca-58ce-a4a6-cea545648681

	measure 'Avg Cost per Unit' = DIVIDE ( [Cost], [Units Sold] )
		formatString: #,0
		displayFolder: Per unit
		lineageTag: 5f283164-9d0b-5b54-ad90-8bf59d1adb4d

	measure 'Profit per Unit' = DIVIDE ( [Profit], [Units Sold] )
		formatString: #,0
		displayFolder: Per unit
		lineageTag: 501b173f-3310-558b-b52c-03d934de2b1b

	measure 'Revenue Share' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], REMOVEFILTERS ( Products ) ) )
		formatString: 0.0%
		displayFolder: Share
		lineageTag: 96073854-0a36-5737-853b-94600514d52e

	measure 'Profit Share' = DIVIDE ( [Profit], CALCULATE ( [Profit], REMOVEFILTERS ( Products ) ) )
		formatString: 0.0%
		displayFolder: Share
		lineageTag: d2122ec2-4612-50f5-aa4b-a871cfb5031e

	measure 'Loss Products' = COALESCE ( CALCULATE ( COUNTROWS ( 'Product Sales' ), 'Product Sales'[Sale Status] = "Sold below cost" ), 0 )
		formatString: #,0
		displayFolder: Pricing
		lineageTag: a7aa78a5-81bb-5a0d-93e9-968ceef3b99a

	measure 'Loss Amount' = - CALCULATE ( [Profit], 'Product Sales'[Sale Status] = "Sold below cost" )
		formatString: #,0
		displayFolder: Pricing
		lineageTag: fc793e9b-34c2-5095-8237-12281573ab55

	measure 'Revenue at Loss' = CALCULATE ( [Revenue], 'Product Sales'[Sale Status] = "Sold below cost" )
		formatString: #,0
		displayFolder: Pricing
		lineageTag: d84be9ff-8bc0-582d-a857-99356c39d70a

	measure 'Low Margin Products' = COALESCE ( CALCULATE ( COUNTROWS ( 'Product Sales' ), 'Product Sales'[Margin Band] = "0-5%" ), 0 )
		formatString: #,0
		displayFolder: Pricing
		lineageTag: fb9975b4-6757-5346-99a5-e3020298d1b1

	measure 'Category Color' = SWITCH ( SELECTEDVALUE ( Products[Category] ), "Tire", "#2A78D6", "Battery", "#EB6834", "Rim", "#1BAF7A", "Service", "#EDA100", "#8A8984" )
		displayFolder: Formatting
		lineageTag: 7cbf2df3-322b-5f02-b9f6-beebdf75fdad

	measure 'Margin Color' = SWITCH ( TRUE (), ISBLANK ( [Margin %] ), "#52514E", [Margin %] < 0, "#D03B3B", [Margin %] < 0.08, "#A35F00", "#0B0B0B" )
		displayFolder: Formatting
		lineageTag: daa54753-3785-59f0-a93e-7ddeca03d5e6

