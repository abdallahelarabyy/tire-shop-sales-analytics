	partition 'Product Sales' = m
		mode: import
		source =
				let
				    Source = LoadCsv("fact_item_sales.csv"),
				    #"Changed Type" = Table.TransformColumnTypes(Source, {{"product_id", Int64.Type}, {"qty_sold", Int64.Type}, {"revenue", type number}, {"cost", type number}, {"profit", type number}, {"unit_price", type number}, {"unit_cost", type number}, {"margin_pct", type number}, {"abc_class", type text}, {"profit_rank", Int64.Type}, {"price_band", type text}, {"price_band_order", Int64.Type}, {"margin_band", type text}, {"margin_band_order", Int64.Type}, {"loss_gap_band", type text}, {"loss_gap_order", Int64.Type}, {"sale_status", type text}}, "en-US"),
				    Kept = Table.SelectColumns(#"Changed Type", {"product_id", "qty_sold", "revenue", "cost", "profit", "unit_price", "unit_cost", "margin_pct", "abc_class", "profit_rank", "price_band", "price_band_order", "margin_band", "margin_band_order", "loss_gap_band", "loss_gap_order", "sale_status"})
				in
				    Kept

	annotation PBI_ResultType = Table
