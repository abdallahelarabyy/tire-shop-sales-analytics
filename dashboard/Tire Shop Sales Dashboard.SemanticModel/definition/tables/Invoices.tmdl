	partition Invoices = m
		mode: import
		source =
				let
				    Source = LoadCsv("fact_invoices.csv"),
				    #"Booleans" = Table.TransformColumns(Source, {{"is_after_midnight", each _ = "True", type logical}, {"is_date_corrected", each _ = "True", type logical}, {"is_time_estimated", each _ = "True", type logical}, {"is_near_zero", each _ = "True", type logical}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Booleans", {{"invoice_no", Int64.Type}, {"invoice_datetime", type datetime}, {"business_date", type date}, {"hour_label", type text}, {"hour_sort", Int64.Type}, {"days_shifted", Int64.Type}, {"customer_type", type text}, {"customer_id", type text}, {"items_count", Int64.Type}, {"gross_amount", type number}, {"discount", type number}, {"tax", type number}, {"net_amount", type number}, {"paid_amount", type number}, {"due_amount", type number}, {"payment_status", type text}, {"ticket_band", type text}, {"ticket_band_order", Int64.Type}}, "en-US"),
				    Kept = Table.SelectColumns(#"Changed Type", {"invoice_no", "invoice_datetime", "business_date", "hour_label", "hour_sort", "is_after_midnight", "is_date_corrected", "days_shifted", "is_time_estimated", "customer_type", "customer_id", "items_count", "gross_amount", "discount", "tax", "net_amount", "paid_amount", "due_amount", "payment_status", "ticket_band", "ticket_band_order", "is_near_zero"})
				in
				    Kept

