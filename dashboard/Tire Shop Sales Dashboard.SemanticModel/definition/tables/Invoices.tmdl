table Invoices
	lineageTag: a015465a-584a-5fa5-8859-3e9aa0cb9232

	measure 'Invoice Revenue' = SUM ( Invoices[Net Amount] )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 61d5ed28-3dcd-5d77-a804-c39559eb33e0

	measure 'Invoice Count' = COUNTROWS ( Invoices )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 52644a34-e765-5a0f-8815-d28b7e38616a

	measure 'Avg Ticket' = DIVIDE ( [Invoice Revenue], [Invoice Count] )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 1b9ba52d-4d81-52ce-84d4-55b5d501ff7f

	measure 'Trading Days' = DISTINCTCOUNT ( Invoices[Business Date] )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 4a1a3399-3d23-57d4-a79c-21e572a28665

	measure 'Revenue per Trading Day' = DIVIDE ( [Invoice Revenue], [Trading Days] )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 120e3956-b0b9-59e4-8095-b929b2e971a0

	measure 'Invoices per Day' = DIVIDE ( [Invoice Count], [Trading Days] )
		formatString: 0.0
		displayFolder: Activity
		lineageTag: 6537d2c6-d265-51fe-8477-65ac37fc6e04

	measure 'Revenue 7-Day Avg' =
			VAR d = MAX ( 'Calendar'[Date] )
			VAR lastDay = CALCULATE ( MAX ( Invoices[Business Date] ), REMOVEFILTERS () )
			RETURN
			    IF ( d > lastDay, BLANK (), AVERAGEX ( DATESINPERIOD ( 'Calendar'[Date], d, -7, DAY ), [Invoice Revenue] ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 43922eb6-7acf-5128-8d1a-f8fe8046bf74

	measure 'Share of Invoices' = DIVIDE ( [Invoice Count], CALCULATE ( [Invoice Count], REMOVEFILTERS ( Invoices[Ticket Band], Invoices[Ticket Band Order] ) ) )
		formatString: 0%
		displayFolder: Activity
		lineageTag: 4ac8461c-25b8-575d-a037-79f85529d5dc

	measure 'Share of Revenue' = DIVIDE ( [Invoice Revenue], CALCULATE ( [Invoice Revenue], REMOVEFILTERS ( Invoices[Ticket Band], Invoices[Ticket Band Order] ) ) )
		formatString: 0%
		displayFolder: Activity
		lineageTag: 80b8d369-4dfc-5143-9549-e0b59d1f1c06

	measure 'After-Midnight Revenue' = CALCULATE ( [Invoice Revenue], Invoices[Is After Midnight] = TRUE () )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 86589fcd-e390-5f6f-ab5a-c9b61fdd4cf1

	measure 'Evening Share' = DIVIDE ( CALCULATE ( [Invoice Count], Invoices[Hour Sort] >= 18 ), [Invoice Count] )
		formatString: 0%
		displayFolder: Activity
		lineageTag: 68118cca-9477-5943-8086-f929edd457a6

	measure 'Heat Color' =
			VAR v = [Invoice Count]
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( 'Calendar'[Weekday], 'Calendar'[Weekday Num] ), ALLSELECTED ( Invoices[Hour], Invoices[Hour Sort] ) ), [Invoice Count] )
			VAR r = DIVIDE ( v, mx )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), "#FFFFFF", r < 0.2, "#EEF4FD", r < 0.4, "#B7D3F6", r < 0.6, "#6DA7EC", r < 0.8, "#2A78D6", "#184F95" )
		displayFolder: Formatting
		lineageTag: 747c7487-946e-51b2-9a85-c63ecab6fe93

	measure 'Heat Font Color' =
			VAR v = [Invoice Count]
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( 'Calendar'[Weekday], 'Calendar'[Weekday Num] ), ALLSELECTED ( Invoices[Hour], Invoices[Hour Sort] ) ), [Invoice Count] )
			RETURN IF ( DIVIDE ( v, mx ) >= 0.6, "#FFFFFF", "#0B0B0B" )
		displayFolder: Formatting
		lineageTag: 54201e90-57f5-55b8-9d5f-f06a74f2dac7

